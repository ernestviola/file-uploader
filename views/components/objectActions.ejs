<div>
  <form
    action="/folders/<%= locals.folder.id %>/files/<%= obj.id %>/update"
    method="post"
  >
    <input type="text" name="name" required />
    <button type="submit">Rename</button>
  </form>
  <form
    action="/folders/<%= locals.folder.id %>/files/<%= obj.id %>/delete"
    method="post"
  >
    <button type="submit">Delete</button>
  </form>
  <a href="/folders/<%= locals.folder.id %>/files/<%= obj.id %>/download"
    >Download</a
  >
</div>
