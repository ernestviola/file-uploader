<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log In</title>
  </head>
  <body>
    <form action="/login" method="post">
      <input
        type="text"
        aria-label="username"
        placeholder="username"
        name="username"
      />
      <input
        type="password"
        aria-label="password"
        placeholder="password"
        name="password"
      />
    </form>
  </body>
</html>
