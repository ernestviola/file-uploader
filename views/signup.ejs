<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up</title>
  </head>
  <body>
    <form action="/signup" method="post">
      <input
        type="text"
        aria-label="username"
        placeholder="username"
        name="username"
        value="<%= locals.formData?.username %>"
      />
      <% if (locals.fieldErrors?.username) {%>
            <span class='error-msg'><%= fieldErrors.username %></span>
      <% } %>
      <input
        type="password"
        aria-label="password"
        placeholder="password"
        name="password"
        value="<%= locals.formData?.password %>"
      />
      <% if (locals.fieldErrors?.password) {%>
            <span class='error-msg'><%= fieldErrors.password %></span>
      <% } %>
      <input
        type="password"
        aria-label="password"
        placeholder="Confirm Password"
        name="confirm_password"
        value=""
      />
      <% if (locals.fieldErrors?.confirm_password) {%>
            <span class='error-msg'><%= fieldErrors.confirm_password %></span>
      <% } %>

      <button type='submit'>Sign Up</button>
    </form>
  </body>
</html>
