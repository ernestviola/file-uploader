<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= locals.folder ? locals.folder.name : '' %></title>
    <link rel='stylesheet' href='/styles/styles.css'>
    <link rel='stylesheet' href='/styles/folder.css'>
  </head>
  <body>
    
    <nav>
      <div class='left'>
        <h1><%= locals.folder ? locals.folder.name : '' %></h1>
        <% if (locals.breadcrumbs) {%>
        <div class='breadcrumbs'>
          <% breadcrumbs.forEach((crumb,i) => { %>
            <% if (i < breadcrumbs.length - 1) {%>
              <span>/<a href='/folders/<%= crumb.id %>'><%= crumb.name %></a></span>
            <% } else { %>
              <span> / <span><%= crumb.name %></span></span>
            <% } %>
          <% }); %>
        </div>
        <% } %>
      </div>
      <div class='right'>
        <a href='/logout'>Logout</a>
      </div>
    </nav>
    
    <form action='/folders/<%= locals.folder.id %>/create' method='post'>
      <input type='text' placeholder='folder name...' name='name' aria-label='Folder Name' required>
      <button type='submit'>New Folder</button>
    </form>
    <form action='/folders/<%= locals.folder.id %>/files/new' method='post' enctype='multipart/form-data'>
      <input type='file' aria-label='New Files' name='files' multiple>
      <button type='submit'>Save</button>
    </form>
    <form action=''>
        <input type='text' name='search' placeholder='search...'>
    </form>
    <div class='explorer'>
      <% if (locals.folderObjects) { %>
        
        <% folderObjects.forEach(obj => { %>
          <% if (obj.type === 'folder') { %>
            <a href='/folders/<%= obj.id %>'><%= obj.name %></a>
          <% } else { %>
            <a href='/folders/<%= locals.folder.id %>/files/<%= obj.id %>/download'><%= obj.name %>.<%= obj.extension %></a>
          <% } %>
        <%}); %>
      <% } %>
    </div>
  </body>
</html>
