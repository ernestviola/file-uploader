<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= locals.folder ? locals.folder.name : '' %></title>
  </head>
  <body>
    <h1><%= locals.folder ? locals.folder.name : '' %></h1>
    <% if (locals.breadcrumbs) {%>
    <nav class='breadcrumbs'>
      <% breadcrumbs.forEach((crumb,i) => { %>
        <% if (i < breadcrumbs.length - 1) {%>
          <a href='/folders/<%= crumb.id %>'><%= crumb.name %></a><span> / </span>
        <% } else { %>
          <span><%= crumb.name %></span>
        <% } %>
      <% }); %>
    </nav>
    <% } %>
    <form action='/folders/<%= locals.folder.id %>/create' method='post'>
      <input type='text' placeholder='folder name...' name='name' aria-label='Folder Name' required>
      <button type='submit'>New Folder</button>
    </form>
    <form action='/folders/<%= locals.folder.id %>/files/new'>
      <input type='file' aria-label='New File'>
    </form>
    <div class='file-explorer'>
      <% if (locals.folder.children) { %>
        <% folder.children.forEach(child => { %>
          <a href='/folders/<%= child.id %>'><%= child.name %></a>
        <% });  %>
      <% } else { %>
        <span>This folder is empty</span>
      <% } %>
    </div>
  </body>
</html>
